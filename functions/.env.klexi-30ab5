# klexi-30ab5 배포 파라미터 (비밀값 아님 — 커밋 대상)
# AUTH_MODE: soft = 토큰 없는 구버전(build52) 요청 허용 / hard = 로그인 토큰 필수
# hard 전환 조건: build53 이상이 Play 분포 90% 이상, 또는 build53 출시 14일 경과.
# 전환 = 이 값을 hard 로 바꾸고 `firebase deploy --only functions` 재배포.
# 비밀값(OPENAI_API_KEY)은 절대 여기 쓰지 말 것 — Secret Manager 사용.
AUTH_MODE=soft
